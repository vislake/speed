# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
*.local

# Go
/go/**/bin/
*.test
*.out

# Python (the checkers and the release coordinator under tools/)
__pycache__/
*.pyc

# Node
node_modules/
dist/
.turbo/
*.tsbuildinfo

# Build artifacts
# /build/* (not /build/) plus the negation below: git cannot re-include a
# file whose PARENT DIRECTORY is itself excluded ("It is not possible to
# re-include a file if a parent directory of that file is excluded" --
# git-scm.com/docs/gitignore), so /build/ itself must not be the excluded
# pattern.
/build/*
# Except the merged multi-module OpenAPI document: a real, committed
# generated artifact (task api:merge / .github/workflows/api-contract.yml's
# git diff --exit-code consistency gate), following the same
# generated-but-committed pattern as internal/notes/api/notes-server.gen.go
# and web/packages/api-sdk/src/index.ts.
!/build/openapi/
/tmp/

# Local data (standalone deployment mode)
*.db
*.db-journal
*.sqlite

# Hugo build output for docs/site/ (docs/site/README.md,
# .github/workflows/docs-site-deploy.yml) -- generated by `hugo --minify`,
# never committed. Hugo's default resource cache directory and its build
# lock file, also never committed.
/docs/site/public/
/docs/site/resources/
/docs/site/.hugo_build.lock
