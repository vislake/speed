# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
*.local

# Go
/go/**/bin/
*.test
*.out
# The tool module's in-place build output: configrefgen is run with
# `go run .` from tools/configrefgen, never as a built binary.
/tools/configrefgen/configrefgen

# Python (the checkers and the release coordinator under tools/)
__pycache__/
*.pyc

# Node
node_modules/
dist/
.turbo/
*.tsbuildinfo

/tmp/

# Local data (standalone deployment mode)
*.db
*.db-journal
*.sqlite

# Hugo build output for docs/site/ (docs/site/README.md,
# .github/workflows/docs-site-deploy.yml) -- generated by `hugo --minify`,
# never committed. Hugo's default resource cache directory and its build
# lock file, also never committed.
/docs/site/public/
/docs/site/resources/
/docs/site/.hugo_build.lock

# Playwright output for the reference-app end-to-end suite
# (examples/reference-app/web/e2e, playwright.config.ts): per-run traces,
# screenshots and failure snapshots plus the HTML report. Diagnostic
# artifacts of one run on one machine, never committed -- CI uploads them
# from its own run instead.
/examples/reference-app/web/test-results/
/examples/reference-app/web/playwright-report/
/examples/reference-app/web/blob-report/
/examples/reference-app/web/.playwright/
