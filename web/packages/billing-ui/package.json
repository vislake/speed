{
  "name": "@speed/billing-ui",
  "version": "0.0.1",
  "description": "Speed billing UI: the billing-documents component family (a newest-first invoice list over the generated billing read operations, with a per-row detail read), every built-in string in the bilingual billing-ui namespace",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/i18n --filter @speed/ui-kit --filter @speed/api-sdk build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@speed/api-sdk": "workspace:*",
    "@speed/i18n": "workspace:*",
    "@speed/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@mui/material": "^9.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@speed/api-client": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
