{
  "name": "@speed/i18n",
  "version": "0.0.0",
  "description": "Speed frontend i18n host: react-i18next instance creation with the documented language-negotiation chain, per-namespace resource registration with no-silent-cross-language-fallback guarantees, and the isolated MUI locale-linkage helper",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mui-locale": {
      "types": "./dist/mui-locale.d.ts",
      "import": "./dist/mui-locale.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "i18next": "^26.4.1",
    "react-i18next": "^17.0.13"
  },
  "peerDependencies": {
    "@mui/material": "^9.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mui/material": "^9.4.0",
    "@types/react": "^19.0.0",
    "react": "^19.2.8"
  }
}
