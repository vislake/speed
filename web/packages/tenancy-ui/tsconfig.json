{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test-utils"],
  "compilerOptions": {
    // tenancy-ui is a DOM-rendering package: JSX compiles through the
    // automatic runtime (react-jsx), same as ui-kit, layout-kit and
    // auth-ui.
    //
    // src/ renders over an @speed/auth-core session and reads @speed/i18n
    // translations; test-utils/ drives sessions through the
    // api-client/api-sdk seam (@speed/api-sdk's runtime subpath before its
    // prefix), renders under the ui-kit theme providers -- whose own
    // sources import @speed/tokens and @speed/i18n/mui-locale, which this
    // program pulls into its graph, so those two resolve to their sources
    // as well. The siblings' published "types" point into their dist/,
    // which is never committed and not yet built in a fresh checkout, so
    // type resolution maps every workspace specifier straight onto the
    // sibling's source -- same pattern ui-kit, auth-core and auth-ui use.
    // Emitted dist/ keeps the bare specifiers, which consumers resolve
    // against the real published packages. Keep this in lockstep with what
    // src/ and test-utils/ import. List order matters:
    // "@speed/api-sdk/runtime" must be tried before its "@speed/api-sdk"
    // prefix, and "@speed/i18n/mui-locale" before "@speed/i18n" (first
    // match wins in paths).
    "jsx": "react-jsx",
    "paths": {
      "@speed/auth-core": ["../auth-core/src/index.ts"],
      "@speed/i18n": ["../i18n/src/index.ts"],
      "@speed/i18n/mui-locale": ["../i18n/src/mui-locale.ts"],
      "@speed/tokens": ["../tokens/src/index.ts"],
      "@speed/ui-kit": ["../ui-kit/src/index.ts"],
      "@speed/api-client": ["../api-client/src/index.ts"],
      "@speed/api-sdk/runtime": ["../api-sdk/src/runtime.ts"],
      "@speed/api-sdk": ["../api-sdk/src/index.ts"]
    }
  }
}
