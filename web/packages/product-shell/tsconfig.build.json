{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ESM authoring rules: NodeNext mode makes tsc emit relative imports
    // verbatim, so sources must write explicit .js extensions (TS2835
    // otherwise) -- the emitted dist/ is then loadable by Node ESM and
    // typecheckable by NodeNext consumers as-is.
    //
    // The workspace dependencies (@speed/auth-core, @speed/auth-ui,
    // @speed/layout-kit) are resolved here exactly like a consumer
    // resolves them: through each package's exports map to its emitted
    // dist/ declarations (no paths mapping). tsconfig.json (the noEmit
    // typecheck, tests included) maps the workspace specifiers onto the
    // siblings' source instead; the build script rebuilds the three
    // dependencies first so the dist declarations this program
    // type-checks against are never stale.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
