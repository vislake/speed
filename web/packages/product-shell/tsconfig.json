{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test-utils"],
  "compilerOptions": {
    // product-shell is a DOM-rendering package: JSX compiles through the
    // automatic runtime (react-jsx), same as ui-kit, layout-kit, auth-ui
    // and tenancy-ui.
    //
    // src/ renders layout-kit's AppShell and auth-ui's SessionEndedScreen
    // over auth-core's session hooks and reads the shell's own
    // announcement through i18n; test-utils/ registers the four sibling
    // namespaces (ui-kit's providers included) and drives sessions
    // through the api-client/api-sdk seam; the journey suites compose
    // tenancy-ui's TenantSwitcher (a test-only import, in
    // devDependencies). Every sibling this program pulls into its graph
    // resolves to the sibling's source via the paths below -- same
    // pattern every DOM-rendering package uses;
    // the siblings' published "types" point into their dist/, which is
    // never committed and not yet built in a fresh checkout. Emitted
    // dist/ keeps the bare specifiers, which consumers resolve against
    // the real published packages. Keep this in lockstep with what src/
    // and test-utils/ import (the workspace alias suite pins this
    // section against the shared package map). List order matters: "@speed/api-sdk/runtime"
    // must be tried before its "@speed/api-sdk" prefix, and
    // "@speed/i18n/mui-locale" before "@speed/i18n" (first match wins in
    // paths).
    "jsx": "react-jsx",
    "paths": {
      "@speed/api-sdk/runtime": ["../api-sdk/src/runtime.ts"],
      "@speed/api-sdk": ["../api-sdk/src/index.ts"],
      "@speed/api-client": ["../api-client/src/index.ts"],
      "@speed/auth-core": ["../auth-core/src/index.ts"],
      "@speed/auth-ui": ["../auth-ui/src/index.ts"],
      "@speed/tenancy-ui": ["../tenancy-ui/src/index.ts"],
      "@speed/layout-kit": ["../layout-kit/src/index.ts"],
      "@speed/i18n/mui-locale": ["../i18n/src/mui-locale.ts"],
      "@speed/i18n/platform-errors": ["../i18n/src/platform-errors.ts"],
      "@speed/i18n": ["../i18n/src/index.ts"],
      "@speed/tokens": ["../tokens/src/index.ts"],
      "@speed/ui-kit": ["../ui-kit/src/index.ts"]
    }
  }
}
