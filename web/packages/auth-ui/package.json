{
  "name": "@speed/auth-ui",
  "version": "0.0.0",
  "description": "Speed auth UI: the sign-in component family (password, SMS code, social channels, registration and the social callback handler) over an @speed/auth-core session, with every built-in string in the bilingual auth-ui namespace",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/auth-core --filter @speed/ui-kit build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@speed/api-sdk": "workspace:*",
    "@speed/auth-core": "workspace:*",
    "@speed/i18n": "workspace:*",
    "@speed/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@mui/material": "^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@speed/api-client": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.87.0"
  }
}
